<mxfile host="Electron" version="29.3.0">
  <diagram name="PD Serving KV Transfer" id="pd-kv-transfer-timeline">
    <mxGraphModel dx="1300" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="540" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ======== TITLE / SUBTITLE ======== -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontStyle=1;fontColor=#333333;" value="PD Serving: KV Transfer Adds TTFT Overhead" vertex="1">
          <mxGeometry x="100" y="10" width="1080" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666;" value="D receives the first token from P right after prefill, but cannot emit it until the full KV transfer completes." vertex="1">
          <mxGeometry x="100" y="39" width="1080" height="17" as="geometry" />
        </mxCell>

        <!-- ================================================================
             SWIM LANE BACKGROUNDS
             Client  : y=60  – 132  (h=72)
             D       : y=135 – 278  (h=143)
             P       : y=281 – 374  (h=93)
        ================================================================ -->
        <mxCell id="bg-client" parent="1" style="rounded=0;html=1;fillColor=#F8F8F8;strokeColor=#DDDDDD;" value="" vertex="1">
          <mxGeometry x="145" y="60"  width="880" height="72"  as="geometry" />
        </mxCell>
        <mxCell id="bg-D" parent="1" style="rounded=0;html=1;fillColor=#EBF5EB;strokeColor=#DDDDDD;" value="" vertex="1">
          <mxGeometry x="145" y="135" width="880" height="143" as="geometry" />
        </mxCell>
        <mxCell id="bg-P" parent="1" style="rounded=0;html=1;fillColor=#EBF0FA;strokeColor=#DDDDDD;" value="" vertex="1">
          <mxGeometry x="145" y="281" width="880" height="93"  as="geometry" />
        </mxCell>

        <!-- LANE DIVIDERS -->
        <mxCell id="div1" parent="1" style="endArrow=none;html=1;strokeColor=#BBBBBB;strokeWidth=1;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="30" y="134" as="sourcePoint"/><mxPoint x="1030" y="134" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="div2" parent="1" style="endArrow=none;html=1;strokeColor=#BBBBBB;strokeWidth=1;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="30" y="280" as="sourcePoint"/><mxPoint x="1030" y="280" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- LANE LABELS -->
        <mxCell id="lbl-client" parent="1" style="rounded=1;html=1;fillColor=#E0E0E0;strokeColor=#999999;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#333333;" value="Client" vertex="1">
          <mxGeometry x="30" y="82"  width="110" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lbl-D" parent="1" style="rounded=1;html=1;fillColor=#C8E6C9;strokeColor=#66BB6A;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1B5E20;" value="Decode Node (D)" vertex="1">
          <mxGeometry x="30" y="195" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lbl-P" parent="1" style="rounded=1;html=1;fillColor=#BBDEFB;strokeColor=#42A5F5;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0D47A1;" value="Prefill Node (P)" vertex="1">
          <mxGeometry x="30" y="309" width="110" height="30" as="geometry" />
        </mxCell>

        <!-- ================================================================
             TIMELINE ARROW  (y=393)
        ================================================================ -->
        <mxCell id="timeline" parent="1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#999999;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="393" as="sourcePoint"/><mxPoint x="1060" y="393" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="timeline-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=bottom;fontSize=11;fontStyle=2;fontColor=#999999;" value="Time →" vertex="1">
          <mxGeometry x="955" y="378" width="60" height="17" as="geometry" />
        </mxCell>

        <!-- ================================================================
             STEP 1 — Client sends request
        ================================================================ -->
        <mxCell id="s1" parent="1" style="ellipse;aspect=fixed;fillColor=#1565C0;fontColor=#fff;fontStyle=1;strokeColor=none;fontSize=11;" value="1" vertex="1">
          <mxGeometry x="159" y="82" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="client-req" parent="1" style="rounded=1;html=1;fillColor=#EEEEEE;strokeColor=#999999;strokeWidth=1;fontSize=11;fontStyle=1;" value="Request" vertex="1">
          <mxGeometry x="184" y="82" width="58" height="26" as="geometry" />
        </mxCell>
        <!-- Arrow: Client → D lane -->
        <mxCell id="arr-c-d" parent="1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#555555;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="213" y="110" as="sourcePoint"/><mxPoint x="213" y="134" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- ================================================================
             D LANE — ROW A (step circles): y=141
             ROW B (activity blocks): y=165, h=36
             ROW C (cross-lane labels): y=210+
        ================================================================ -->

        <!-- ROW B: D receives request -->
        <mxCell id="D-recv-req" parent="1" style="rounded=1;html=1;fillColor=#C8E6C9;strokeColor=#66BB6A;strokeWidth=1;fontSize=10;fontStyle=1;" value="Receive" vertex="1">
          <mxGeometry x="193" y="165" width="54" height="36" as="geometry" />
        </mxCell>

        <!-- ================================================================
             STEP 2 — D forwards request to P
        ================================================================ -->
        <mxCell id="s2" parent="1" style="ellipse;aspect=fixed;fillColor=#1565C0;fontColor=#fff;fontStyle=1;strokeColor=none;fontSize=11;" value="2" vertex="1">
          <mxGeometry x="213" y="213" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="arr-d-p" parent="1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="237" y="190" as="sourcePoint"/><mxPoint x="264" y="280" as="targetPoint"/></mxGeometry>
        </mxCell>
        <!-- "forward req" label moved right of s2+arrow -->
        <mxCell id="arr-d-p-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#1565C0;" value="forward req" vertex="1">
          <mxGeometry x="280" y="242" width="62" height="13" as="geometry" />
        </mxCell>

        <!-- ROW B: D waiting for prefill (gray dashed) — x=251 to x=641 -->
        <mxCell id="D-wait-prefill" parent="1" style="rounded=0;html=1;fillColor=#F5F5F5;strokeColor=#BBBBBB;strokeWidth=1;dashed=1;dashPattern=6 4;fontSize=9;fontStyle=2;fontColor=#999999;" value="Waiting for prefill completion..." vertex="1">
          <mxGeometry x="251" y="165" width="390" height="36" as="geometry" />
        </mxCell>

        <!-- ================================================================
             STEP 3 — P receives and runs prefill
             s3 at x=244 → right edge 266, gap to P-prefill (x=274) = 8px
        ================================================================ -->
        <mxCell id="s3" parent="1" style="ellipse;aspect=fixed;fillColor=#1565C0;fontColor=#fff;fontStyle=1;strokeColor=none;fontSize=11;" value="3" vertex="1">
          <mxGeometry x="244" y="281" width="22" height="22" as="geometry" />
        </mxCell>
        <!-- Prefill block: x=274 to x=640 -->
        <mxCell id="P-prefill" parent="1" style="rounded=0;html=1;fillColor=#4472C4;strokeColor=#2F5597;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" value="Prefill Compute" vertex="1">
          <mxGeometry x="274" y="295" width="366" height="56" as="geometry" />
        </mxCell>

        <!-- ================================================================
             STEP 4 — P sends first token + metadata to D (fast, small msg)
             s4 placed in gap between P-prefill end (x=640) and P-kv start (x=665)
             Positioned above P lane to avoid occlusion
        ================================================================ -->
        <mxCell id="s4" parent="1" style="ellipse;aspect=fixed;fillColor=#1565C0;fontColor=#fff;fontStyle=1;strokeColor=none;fontSize=11;" value="4" vertex="1">
          <mxGeometry x="615" y="259" width="22" height="22" as="geometry" />
        </mxCell>
        <!-- Thin dashed arrow P→D (first token+meta) -->
        <mxCell id="arr-p-d-token" parent="1" style="endArrow=open;endSize=8;html=1;strokeWidth=2;strokeColor=#E65100;dashed=1;dashPattern=5 3;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="640" y="293" as="sourcePoint"/><mxPoint x="646" y="201" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="arr-p-d-token-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#E65100;" value="1st token + meta" vertex="1">
          <mxGeometry x="648" y="213" width="93" height="13" as="geometry" />
        </mxCell>

        <!-- ================================================================
             ROW A step circles: s5 above D-recv-token, s6 above D1
             ROW B: D-recv-token (quick, w=65), D-wait-kv (longer, x=713 w=70)
        ================================================================ -->

        <!-- ROW A: step circles -->
        <mxCell id="s5" parent="1" style="ellipse;aspect=fixed;fillColor=#1565C0;fontColor=#fff;fontStyle=1;strokeColor=none;fontSize=11;" value="5" vertex="1">
          <mxGeometry x="648" y="141" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="ellipse;aspect=fixed;fillColor=#1565C0;fontColor=#fff;fontStyle=1;strokeColor=none;fontSize=11;" value="6" vertex="1">
          <mxGeometry x="834" y="141" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- ROW B: D receives first token + meta (quick op → narrow box) x=645-710 -->
        <mxCell id="D-recv-token" parent="1" style="rounded=1;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1;fontSize=9;fontStyle=1;fontColor=#BF360C;whiteSpace=wrap;" value="Recv 1st token + meta" vertex="1">
          <mxGeometry x="645" y="165" width="65" height="36" as="geometry" />
        </mxCell>

        <!-- Trigger arrow: D-recv-token end → P-kv start (signals KV transfer initiation) -->
        <mxCell id="arr-recv-kv-trigger" parent="1" style="endArrow=open;endSize=8;html=1;strokeWidth=1.5;strokeColor=#E65100;dashed=1;dashPattern=5 3;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="710" y="201" as="sourcePoint"/><mxPoint x="710" y="295" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- ROW B: D waiting for KV transfer (bulk data) — end at x=822 matching P-kv end -->
        <mxCell id="D-wait-kv" parent="1" style="rounded=0;html=1;fillColor=#FFEBEE;strokeColor=#EF9A9A;strokeWidth=1;dashed=1;dashPattern=6 4;fontSize=9;fontStyle=2;fontColor=#C62828;" value="Wait KV" vertex="1">
          <mxGeometry x="713" y="165" width="109" height="36" as="geometry" />
        </mxCell>

        <!-- ================================================================
             P lane: KV Transfer block
             Starts at x=665 (after metadata send at x=640–664), w=112, ends x=777
        ================================================================ -->
        <mxCell id="P-kv" parent="1" style="rounded=0;html=1;fillColor=#E53935;strokeColor=#B71C1C;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" value="KV Transfer (P → D)" vertex="1">
          <mxGeometry x="710" y="295" width="112" height="56" as="geometry" />
        </mxCell>
        <mxCell id="P-kv-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=8;fontColor=#FFCDD2;" value="via RDMA / RoCE" vertex="1">
          <mxGeometry x="710" y="329" width="112" height="13" as="geometry" />
        </mxCell>

        <!-- ================================================================
             KV transfer arrow: P lane → D lane
             Label moved right+up toward decode area
        ================================================================ -->
        <mxCell id="arr-kv" parent="1" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#B71C1C;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="757" y="293" as="sourcePoint"/><mxPoint x="780" y="201" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="arr-kv-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#B71C1C;" value="KV cache →" vertex="1">
          <mxGeometry x="840" y="208" width="70" height="13" as="geometry" />
        </mxCell>

        <!-- ================================================================
             STEP 6 — KV complete: D emits first token, starts decode
        ================================================================ -->

        <!-- Arrow D → Client (emit first token): x=834 -->
        <mxCell id="arr-d-c" parent="1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#2E7D32;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="834" y="135" as="sourcePoint"/><mxPoint x="834" y="110" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- "First Token!" box in Client lane -->
        <mxCell id="client-first-token" parent="1" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#66BB6A;strokeWidth=1;fontSize=10;fontStyle=1;fontColor=#1B5E20;" value="First Token!" vertex="1">
          <mxGeometry x="797" y="82" width="74" height="26" as="geometry" />
        </mxCell>

        <!-- ROW B: Decode iterations aligned with TTFT right dashed line (x=834) -->
        <mxCell id="D1" parent="1" style="rounded=0;html=1;fillColor=#388E3C;strokeColor=#1B5E20;strokeWidth=1;fontColor=#FFFFFF;fontSize=9;fontStyle=1;" value="D1" vertex="1"><mxGeometry x="834" y="165" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="D2" parent="1" style="rounded=0;html=1;fillColor=#388E3C;strokeColor=#1B5E20;strokeWidth=1;fontColor=#FFFFFF;fontSize=9;fontStyle=1;" value="D2" vertex="1"><mxGeometry x="873" y="165" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="D3" parent="1" style="rounded=0;html=1;fillColor=#388E3C;strokeColor=#1B5E20;strokeWidth=1;fontColor=#FFFFFF;fontSize=9;fontStyle=1;" value="D3" vertex="1"><mxGeometry x="912" y="165" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="D4" parent="1" style="rounded=0;html=1;fillColor=#388E3C;strokeColor=#1B5E20;strokeWidth=1;fontColor=#FFFFFF;fontSize=9;fontStyle=1;" value="D4" vertex="1"><mxGeometry x="951" y="165" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="D-dots" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#388E3C;" value="..." vertex="1"><mxGeometry x="990" y="165" width="28" height="36" as="geometry" /></mxCell>

        <!-- ================================================================
             TTFT BRACKET  (y=408)
        ================================================================ -->
