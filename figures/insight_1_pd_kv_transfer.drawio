        </mxCell>
        <mxCell id="ttft-tick-l" parent="1" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#CC0000;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="213" y="403" as="sourcePoint"/><mxPoint x="213" y="413" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ttft-tick-r" parent="1" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#CC0000;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="834" y="403" as="sourcePoint"/><mxPoint x="834" y="413" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ttft-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#CC0000;" value="PD TTFT" vertex="1">
          <mxGeometry x="445" y="413" width="110" height="18" as="geometry" />
        </mxCell>
        <mxCell id="ttft-sub-l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#CC0000;" value="Request arrives" vertex="1">
          <mxGeometry x="165" y="414" width="90" height="13" as="geometry" />
        </mxCell>
        <mxCell id="ttft-sub-r" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#CC0000;" value="First token emitted" vertex="1">
          <mxGeometry x="789" y="414" width="92" height="13" as="geometry" />
        </mxCell>

        <!-- ================================================================
             RIGHT PANELS — moved to x=1070 with margins (canvas=1360, right margin=22px)
        ================================================================ -->

        <!-- Request Flow panel -->
        <mxCell id="steps-bg" parent="1" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;" value="" vertex="1">
          <mxGeometry x="1070" y="65" width="268" height="200" as="geometry" />
        </mxCell>
        <mxCell id="steps-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" value="Request Flow" vertex="1">
          <mxGeometry x="1086" y="73" width="110" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sd1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#444444;" value="&lt;b&gt;1&lt;/b&gt;  Client sends request → D receives" vertex="1"><mxGeometry x="1086" y="95"  width="238" height="14" as="geometry" /></mxCell>
        <mxCell id="sd2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#444444;" value="&lt;b&gt;2&lt;/b&gt;  D forwards request to P" vertex="1"><mxGeometry x="1086" y="115" width="238" height="14" as="geometry" /></mxCell>
        <mxCell id="sd3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#444444;" value="&lt;b&gt;3&lt;/b&gt;  P runs prefill compute" vertex="1"><mxGeometry x="1086" y="135" width="238" height="14" as="geometry" /></mxCell>
        <mxCell id="sd4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#E65100;" value="&lt;b&gt;4&lt;/b&gt;  P sends 1st token + metadata to D" vertex="1"><mxGeometry x="1086" y="155" width="238" height="14" as="geometry" /></mxCell>
        <mxCell id="sd5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#C62828;" value="&lt;b&gt;5&lt;/b&gt;  KV transfer P→D starts; D waits" vertex="1"><mxGeometry x="1086" y="175" width="238" height="14" as="geometry" /></mxCell>
        <mxCell id="sd6" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#2E7D32;" value="&lt;b&gt;6&lt;/b&gt;  KV done → D emits 1st token, decode starts" vertex="1"><mxGeometry x="1086" y="195" width="238" height="14" as="geometry" /></mxCell>
        <mxCell id="sd-note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#CC0000;" value="Steps 2 + 5 are PD-only overhead" vertex="1"><mxGeometry x="1086" y="228" width="238" height="14" as="geometry" /></mxCell>

        <!-- Legend panel -->
        <mxCell id="legend-bg" parent="1" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;" value="" vertex="1">
