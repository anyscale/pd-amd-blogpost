        </mxCell>
        <mxCell id="leg-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" value="Legend" vertex="1"><mxGeometry x="1086" y="285" width="80" height="16" as="geometry" /></mxCell>
        <mxCell id="leg-sw1" parent="1" style="rounded=0;html=1;fillColor=#4472C4;strokeColor=none;" value="" vertex="1"><mxGeometry x="1089" y="307" width="22" height="12" as="geometry" /></mxCell>
        <mxCell id="leg-lb1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="Prefill compute" vertex="1"><mxGeometry x="1117" y="305" width="196" height="16" as="geometry" /></mxCell>
        <mxCell id="leg-sw2" parent="1" style="rounded=0;html=1;fillColor=#E53935;strokeColor=none;" value="" vertex="1"><mxGeometry x="1089" y="327" width="22" height="12" as="geometry" /></mxCell>
        <mxCell id="leg-lb2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="KV transfer (overhead)" vertex="1"><mxGeometry x="1117" y="325" width="196" height="16" as="geometry" /></mxCell>
        <mxCell id="leg-sw3" parent="1" style="rounded=0;html=1;fillColor=#388E3C;strokeColor=none;" value="" vertex="1"><mxGeometry x="1089" y="347" width="22" height="12" as="geometry" /></mxCell>
        <mxCell id="leg-lb3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="Decode iterations" vertex="1"><mxGeometry x="1117" y="345" width="196" height="16" as="geometry" /></mxCell>
        <mxCell id="leg-sw4" parent="1" style="rounded=0;html=1;fillColor=#F5F5F5;strokeColor=#BBBBBB;dashed=1;" value="" vertex="1"><mxGeometry x="1089" y="367" width="22" height="12" as="geometry" /></mxCell>
        <mxCell id="leg-lb4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="Waiting / idle" vertex="1"><mxGeometry x="1117" y="365" width="196" height="16" as="geometry" /></mxCell>

        <!-- ================================================================
             COMPARISON + INSIGHT BOXES  (y=443)
        ================================================================ -->
        <mxCell id="cmp-bg" parent="1" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;" value="" vertex="1">
          <mxGeometry x="30" y="443" width="560" height="78" as="geometry" />
        </mxCell>
        <mxCell id="cmp-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" value="TTFT Comparison" vertex="1">
