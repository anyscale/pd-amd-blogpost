        <mxCell id="decode-bracket-h" parent="1" style="endArrow=none;startArrow=none;html=1;strokeWidth=2;strokeColor=#C55A11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="244" as="sourcePoint" />
            <mxPoint x="1125" y="244" as="targetPoint" />
          </mxGeometry>
        </mxCell>
