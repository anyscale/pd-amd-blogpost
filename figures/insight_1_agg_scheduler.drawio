<mxfile host="Electron" version="29.3.0">
  <diagram name="Aggregated Serving Timeline" id="agg-scheduler-timeline">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="470" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ======== TITLE ======== -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;fontColor=#333333;" value="Aggregated Serving: vLLM Scheduler Timeline" vertex="1">
          <mxGeometry x="20" y="10" width="1180" height="28" as="geometry" />
        </mxCell>

        <!-- ======== SUBTITLE ======== -->
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#666666;" value="128 requests in decode phase. At iteration N, a new 10k-token request arrives: chunked into 8064 tokens (N) then 2048 tokens (N+1). Token budget per iteration: 8192. Each column spans the full budget." vertex="1">
          <mxGeometry x="20" y="41" width="1180" height="19" as="geometry" />
        </mxCell>

        <!-- ================================================================
             6 EQUAL-WIDTH CONTAINERS (170px wide, 15px gaps)
             Each container = full 8192 token budget
             Gray fill = unused budget capacity
             Blue fill = prefill tokens used
             Orange fill = decode tokens used

             x_base: N=30, N+1=215, N+2=400, N+3=585, N+4=770, N+5=955
             y=88, h=100

             N:   prefill x=30  w=160  | decode x=190 w=10  | gray fills rest (none, uses 100%)
             N+1: prefill x=215 w=42   | decode x=257 w=10  | gray x=267 w=118
             N+2: decode x=400 w=10    | gray x=410   w=160
             N+3: decode x=585 w=10    | gray x=595   w=160
             N+4: decode x=770 w=10    | gray x=780   w=160
             N+5: decode x=955 w=10    | gray x=965   w=160
        ================================================================ -->

        <!-- ======== GRAY BACKGROUNDS (budget capacity) ======== -->
        <mxCell id="N-bg"   parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#D0D0D0;strokeWidth=1;" value="" vertex="1"><mxGeometry x="30"  y="88" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="N1-bg"  parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#D0D0D0;strokeWidth=1;" value="" vertex="1"><mxGeometry x="215" y="88" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="N2-bg"  parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#D0D0D0;strokeWidth=1;" value="" vertex="1"><mxGeometry x="400" y="88" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="N3-bg"  parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#D0D0D0;strokeWidth=1;" value="" vertex="1"><mxGeometry x="585" y="88" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="N4-bg"  parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#D0D0D0;strokeWidth=1;" value="" vertex="1"><mxGeometry x="770" y="88" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="N5-bg"  parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#D0D0D0;strokeWidth=1;" value="" vertex="1"><mxGeometry x="955" y="88" width="170" height="100" as="geometry" /></mxCell>

        <!-- ======== ITERATION N ======== -->
        <!-- N: Prefill Chunk 1 (8064/8192 × 170 ≈ 167px → 160px leaving 10px for decode) -->
        <mxCell id="iterN-prefill" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4472C4;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" value="Prefill Chunk 1&lt;br/&gt;8064 tokens" vertex="1">
          <mxGeometry x="30" y="88" width="160" height="100" as="geometry" />
        </mxCell>
        <!-- N: Decode (128 tokens → 10px minimum) -->
        <mxCell id="iterN-decode" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ED7D31;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="190" y="88" width="10" height="100" as="geometry" />
        </mxCell>

        <!-- ======== ITERATION N+1 ======== -->
        <!-- N+1: Prefill Chunk 2 (2048/8192 × 170 ≈ 42px) -->
        <mxCell id="iterN1-prefill" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4472C4;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="215" y="88" width="42" height="100" as="geometry" />
        </mxCell>
        <!-- N+1: Decode (128 tokens → 10px minimum) -->
        <mxCell id="iterN1-decode" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ED7D31;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="257" y="88" width="10" height="100" as="geometry" />
        </mxCell>
        <!-- N+1: Label inside gray area -->
        <mxCell id="iterN1-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="Prefill Chunk 2&lt;br/&gt;2048 tokens&lt;br/&gt;&lt;font color=&apos;#ED7D31&apos;&gt;+ 128 decode&lt;/font&gt;" vertex="1">
          <mxGeometry x="267" y="88" width="118" height="100" as="geometry" />
        </mxCell>

        <!-- ======== ITERATIONS N+2 to N+5 (decode only) ======== -->
        <mxCell id="iterN2-decode" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ED7D31;strokeColor=none;" value="" vertex="1"><mxGeometry x="400" y="88" width="10" height="100" as="geometry" /></mxCell>
        <mxCell id="iterN3-decode" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ED7D31;strokeColor=none;" value="" vertex="1"><mxGeometry x="585" y="88" width="10" height="100" as="geometry" /></mxCell>
        <mxCell id="iterN4-decode" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ED7D31;strokeColor=none;" value="" vertex="1"><mxGeometry x="770" y="88" width="10" height="100" as="geometry" /></mxCell>
        <mxCell id="iterN5-decode" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ED7D31;strokeColor=none;" value="" vertex="1"><mxGeometry x="955" y="88" width="10" height="100" as="geometry" /></mxCell>

        <!-- Labels inside gray area of N+2..N+5 -->
        <mxCell id="iterN2-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="129 decode&lt;br/&gt;tokens" vertex="1"><mxGeometry x="410" y="88" width="160" height="100" as="geometry" /></mxCell>
        <mxCell id="iterN3-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="129 decode&lt;br/&gt;tokens" vertex="1"><mxGeometry x="595" y="88" width="160" height="100" as="geometry" /></mxCell>
        <mxCell id="iterN4-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="129 decode&lt;br/&gt;tokens" vertex="1"><mxGeometry x="780" y="88" width="160" height="100" as="geometry" /></mxCell>
        <mxCell id="iterN5-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="129 decode&lt;br/&gt;tokens" vertex="1"><mxGeometry x="965" y="88" width="160" height="100" as="geometry" /></mxCell>

        <!-- ======== ITERATION LABELS ABOVE ======== -->
        <mxCell id="iterN-label"  parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" value="Iteration N"   vertex="1"><mxGeometry x="30"  y="63" width="170" height="22" as="geometry" /></mxCell>
        <mxCell id="iterN1-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" value="Iteration N+1" vertex="1"><mxGeometry x="215" y="63" width="170" height="22" as="geometry" /></mxCell>
        <mxCell id="iterN2-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" value="Iteration N+2" vertex="1"><mxGeometry x="400" y="63" width="170" height="22" as="geometry" /></mxCell>
        <mxCell id="iterN3-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" value="Iteration N+3" vertex="1"><mxGeometry x="585" y="63" width="170" height="22" as="geometry" /></mxCell>
        <mxCell id="iterN4-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" value="Iteration N+4" vertex="1"><mxGeometry x="770" y="63" width="170" height="22" as="geometry" /></mxCell>
        <mxCell id="iterN5-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" value="Iteration N+5" vertex="1"><mxGeometry x="955" y="63" width="170" height="22" as="geometry" /></mxCell>

        <!-- ======== TIMELINE ARROW ======== -->
        <mxCell id="timeline-arrow" parent="1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#999999;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="25" y="82" as="sourcePoint" />
            <mxPoint x="1190" y="82" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="timeline-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#999999;" value="Time →" vertex="1">
          <mxGeometry x="1152" y="62" width="60" height="18" as="geometry" />
        </mxCell>

        <!-- ================================================================
             ANNOTATIONS BELOW BLOCKS
        ================================================================ -->

        <!-- Token totals (y=192) -->
        <mxCell id="ann-N-total"   parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="8192 tokens" vertex="1"><mxGeometry x="30"  y="192" width="170" height="16" as="geometry" /></mxCell>
        <mxCell id="ann-N1-total"  parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="2176 tokens" vertex="1"><mxGeometry x="215" y="192" width="170" height="16" as="geometry" /></mxCell>
        <mxCell id="ann-N25-total" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="129 tokens each" vertex="1"><mxGeometry x="400" y="192" width="725" height="16" as="geometry" /></mxCell>

        <!-- Budget % (y=210) -->
        <mxCell id="ann-N-pct"   parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#888888;" value="(100% of budget)" vertex="1"><mxGeometry x="30"  y="210" width="170" height="15" as="geometry" /></mxCell>
        <mxCell id="ann-N1-pct"  parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#888888;" value="(26.5% of budget)" vertex="1"><mxGeometry x="215" y="210" width="170" height="15" as="geometry" /></mxCell>
        <mxCell id="ann-N25-pct" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#888888;" value="(1.6% of budget each)" vertex="1"><mxGeometry x="400" y="210" width="725" height="15" as="geometry" /></mxCell>

        <!-- ================================================================
             TTFT ANNOTATION
             Vertical dashed red line at x=385 (right edge of N+1 container)
        ================================================================ -->
        <mxCell id="ttft-vline" parent="1" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#CC0000;dashed=1;dashPattern=6 4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="385" y="82" as="sourcePoint" />
            <mxPoint x="385" y="233" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ttft-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#CC0000;" value="← TTFT: Prefill completes here" vertex="1">
          <mxGeometry x="148" y="224" width="235" height="18" as="geometry" />
        </mxCell>

        <!-- ================================================================
             PHASE BRACKET LINES  (y=244)
             Prefill phase: x=30 to x=385   (Iterations N and N+1)
             Decode phase:  x=400 to x=1125  (Iterations N+2 to N+5)
        ================================================================ -->

        <!-- Prefill bracket -->
        <mxCell id="prefill-bracket-h" parent="1" style="endArrow=none;startArrow=none;html=1;strokeWidth=2;strokeColor=#4472C4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="30" y="244" as="sourcePoint" />
            <mxPoint x="385" y="244" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="prefill-tick-l" parent="1" style="endArrow=none;startArrow=none;html=1;strokeWidth=2;strokeColor=#4472C4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="30" y="238" as="sourcePoint" />
            <mxPoint x="30" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="prefill-tick-r" parent="1" style="endArrow=none;startArrow=none;html=1;strokeWidth=2;strokeColor=#4472C4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="385" y="238" as="sourcePoint" />
            <mxPoint x="385" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="prefill-phase-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#4472C4;" value="Prefill Phase (chunked)" vertex="1">
          <mxGeometry x="30" y="252" width="355" height="18" as="geometry" />
        </mxCell>

