        <mxCell id="legend-s5" value="&lt;font color=&quot;#2e7d32&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;  KV cache transferred Prefill → Decode via NIXL/RDMA" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=11;" vertex="1" parent="1">
