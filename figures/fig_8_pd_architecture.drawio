        <mxCell id="legend-s3" value="&lt;font color=&quot;#1071e5&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;  Decode forwards request to Prefill for prefill computation" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#333;fontSize=11;" vertex="1" parent="1">
