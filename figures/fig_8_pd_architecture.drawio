        <mxCell id="tokens-callout" value="&lt;b style=&quot;font-size:13px;color:#e65100;&quot;&gt;Asymmetric Batching&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Prefill: &lt;b style=&quot;color:#1b5e20;font-size:14px;&quot;&gt;32,768&lt;/b&gt; tokens&lt;br&gt;Decode: &lt;b style=&quot;color:#c62828;font-size:14px;&quot;&gt;4,096&lt;/b&gt; tokens&lt;br&gt;&lt;b&gt;8x ratio&lt;/b&gt; &amp;mdash; each node optimized&lt;br&gt;for its specific workload&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
