        <mxCell id="hw-gpu" value="&lt;b style=&quot;font-size:14px;color:#0078d4;&quot;&gt;AMD Instinct MI325X&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;288 GB HBM3e per GPU&lt;br&gt;4 nodes x 8 GPUs = &lt;b&gt;32 GPUs total&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;html=1;whiteSpace=wrap;shadow=1;" vertex="1" parent="1">
