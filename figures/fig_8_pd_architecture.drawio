        <mxCell id="prefill2-nixl" value="&lt;b style=&quot;font-size:12px;&quot;&gt;NixlConnector&lt;/b&gt;" style="rounded=1;fillColor=#e8f5e9;strokeColor=#43a047;strokeWidth=2;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
